{
  "$schema": "https://opencode.ai/config.json",

  // ─── Providers ────────────────────────────────────────────────────────────
  // Two providers are used across all agents:
  //   • nvidia   — NVIDIA NIM (build.nvidia.com) for minimax-m3 and kimi-k2.6
  //   • openrouter — OpenRouter for nemotron, gpt-oss, qwen3-coder, cohere models
  "provider": {
    "nvidia": {
      // Keys stored via: /connect → NVIDIA
      // Covers NIM-hosted models: moonshotai/kimi-k2.6, minimaxai/minimax-m3
      "models": {
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6 (NIM)"
        },
        "minimaxai/minimax-m3": {
          "name": "MiniMax M3 (NIM)"
        }
      }
    },
    
    "cerebras": {
        // Keys stored via: /connect → Cerebras
        // Free tier: 1M tokens/day, no credit card required
        // Models available: https://inference-docs.cerebras.ai/introduction
        "models": {
            "cerebras/gpt-oss-120b": {
                "name": "GPT-OSS 120B (Cerebras)"
            },
            "cerebras/zai-glm-4.7": {
                "name": "Z.ai GLM 4.7 (Cerebras)"
            }
        }
    },

    "openrouter": {
      // Keys stored via: /connect → OpenRouter
      // Covers all openrouter/* models used in agents as primary or fallback
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron Ultra 550B (free)"
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "Nemotron Super 120B (free)"
        },
        "nvidia/nemotron-3-nano-30b-a3b:free": {
          "name": "Nemotron Nano 30B (free)"
        },
        "openai/gpt-oss-120b:free": {
          "name": "GPT-OSS 120B (free)"
        },
        "openai/gpt-oss-20b:free": {
          "name": "GPT-OSS 20B (free)"
        },
        "qwen/qwen3-coder:free": {
          "name": "Qwen3 Coder (free)"
        },
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (free)"
        }
      }
    }
  },

  // ─── Global permissions ────────────────────────────────────────────────────
  // Sensible safe defaults for interactive use. Agents override these.
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "task": "ask"
  }
}